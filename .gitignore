/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Browser checks / Remotion cache
/test-results/
/docs/design/previews/*.json
/.cache/

# Nested design prototype dependencies and Impeccable local engine
**/node_modules/
.agents/skills/impeccable/scripts/bin/
.impeccable/review/
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/config.local.json

# Raw research downloads may contain third-party credentials or bootstrap data.
# Keep source links and curated Markdown notes instead of page/script dumps.
/docs/research/**/raw/
/docs/research/2026-10-02/motion/webdev-animation.txt
